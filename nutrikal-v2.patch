+.hero .eyebrow { animation-delay: 0.05s; } .hero__title { animation-delay: 0.12s; } .hero__lead { animation-delay: 0.2s; } .hero__actions { animation-delay: 0.28s; }
+.hero__stat:nth-child(1) { animation-delay: 0.2s; } .hero__stat:nth-child(2) { animation-delay: 0.3s; } .hero__stat:nth-child(3) { animation-delay: 0.4s; }
+.feature-card[data-reveal], .steps li[data-reveal] { transition-delay: calc(var(--i, 0) * 90ms); }
+.nav-link.is-active { color: var(--foreground); }
+.nav-link.is-active::after { transform: scaleX(1); opacity: 1; }
+.diet-item { animation: itemIn 0.35s ease both; }
+.result-card { transition: transform 0.2s ease; } .result-card:hover { transform: translateY(-2px); }
